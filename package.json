{
  "name": "qx7-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end Playwright tests for the QX7 admin, run against a local QX7 site",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:login": "playwright test tests/auth/login.spec.ts --project=chromium",
    "test:login:headed": "playwright test tests/auth/login.spec.ts --project=chromium --headed",
    "test:programmatic": "playwright test tests/programmatic-updates --project=chromium",
    "test:programmatic:headed": "playwright test tests/programmatic-updates --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.2",
    "dotenv": "16.4.7",
    "typescript": "5.7.2"
  }
}
