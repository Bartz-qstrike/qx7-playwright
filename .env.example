# Copy to .env and fill in a LOCAL admin account (never a production one).
QX7_BASE_URL=http://qx7.test
QX7_EMAIL=
QX7_PASSWORD=
QX7_BRAND_BLOCK_INDEX=http://qx7.test/admin/brand/block_pattern_rules
QX7_SRE_3215_CSV=SRE-3215 Audit - Affected Block.csv
# Optional: only process the first N CSV rows (blank = all)
QX7_BLOCK_LIMIT=
